{
  "id": "primitives",
  "label": "Primitives",
  "title": "Template primitives",
  "intro": "Generated by scripts/mage-render.mjs from .mage/<slug>/*.md; rerun it instead of editing the page. Markdown maps to p, h, list, steps, callout, table, code and mermaid blocks. The shapes below are the full set a page can render.",
  "sections": [
    {
      "title": "Block types",
      "blocks": [
        {
          "type": "table",
          "columns": [
            "type",
            "Fields",
            "Use for"
          ],
          "rows": [
            [
              "`p`",
              "`text`",
              "A paragraph."
            ],
            [
              "`list`",
              "`items[]`",
              "Bulleted list."
            ],
            [
              "`steps`",
              "`items[]`",
              "Ordered sequence where order matters."
            ],
            [
              "`callout`",
              "`tone` (info, warn, ok, decision), `title`, `text`",
              "One thing the reader must not miss."
            ],
            [
              "`table`",
              "`columns[]`, `rows[][]`",
              "Any grid."
            ],
            [
              "`reqs`",
              "`rows[{id, pri, text, accept?}]`",
              "FR/NFR lists. `pri`: must, should, could."
            ],
            [
              "`decisions`",
              "`rows[{id, q, choice, by}]`",
              "Decision log."
            ],
            [
              "`facts`",
              "`rows[{claim, evidence, grade}]`",
              "Grounded claims. `grade`: verified, inferred."
            ],
            [
              "`questions`",
              "`rows[{id, status, text, answer?}]`",
              "Open items. `status`: open, default, resolved."
            ],
            [
              "`risks`",
              "`rows[{level, risk, mitigation}]`",
              "Risk register. `level`: high, medium, low."
            ],
            [
              "`split`",
              "`left{title, items}`, `right{title, items}`",
              "In / out scope."
            ],
            [
              "`glossary`",
              "`terms[{term, def}]`",
              "Definitions."
            ],
            [
              "`code`",
              "`lang`, `text`",
              "Commands or payloads, with a copy button."
            ],
            [
              "`mermaid`",
              "`text`",
              "Diagram source from a ```mermaid fence; renders client-side with a source fallback"
            ],
            [
              "`stats`",
              "`items[[value, label]]`",
              "A short count strip."
            ]
          ]
        }
      ]
    },
    {
      "title": "Page fields",
      "blocks": [
        {
          "type": "table",
          "columns": [
            "Field",
            "Meaning"
          ],
          "rows": [
            [
              "`project`, `projectUrl`",
              "Ticket key and link in the eyebrow."
            ],
            [
              "`title`, `lede`",
              "Page heading and one-line purpose."
            ],
            [
              "`meta[[label, value]]`",
              "Owner, dates, repo."
            ],
            [
              "`phases[{name, state, note}]`",
              "redMage rail. `state`: done, draft, next, todo, skipped."
            ],
            [
              "`docs[{id, label, title, intro, sections}]`",
              "One tab each. `id` is the deep-link anchor, e.g. `#trd`."
            ]
          ]
        }
      ]
    },
    {
      "title": "Example",
      "blocks": [
        {
          "type": "code",
          "lang": "json",
          "text": "{\"title\": \"Open questions\", \"blocks\": [\n  {\"type\": \"questions\", \"rows\": [\n    {\"id\": \"Q1\", \"status\": \"open\", \"text\": \"SORD switch date?\"}\n  ]}\n]}"
        }
      ]
    },
    {
      "title": "Mermaid example",
      "blocks": [
        {
          "type": "p",
          "text": "A ```mermaid fence in any record becomes a diagram. The source stays under Source and shows as text if the library cannot load."
        },
        {
          "type": "mermaid",
          "text": "flowchart LR\n  A[Scan] --> B[Analyze] --> C[Protect] --> D[Chain] --> E[Weave] --> F[Dispel]"
        }
      ]
    }
  ]
}
